{
  "version": 2,
  "builds": [
    {
      "src": "api/digialm.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/digialm",
      "dest": "api/digialm.js"
    },
    {
      "src": "/digialm",
      "dest": "api/digialm.js"
    },
    {
      "src": "/",
      "dest": "index.js"
    }
  ]
}
